# Android Release Keystore Signing Configuration Example
# Copy this file to key.properties (in the android/ root directory) and fill with your release keystore credentials.
# NOTE: DO NOT commit key.properties or *.jks files to git.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks

# To generate a new upload keystore:
# keytool -genkey -v -keystore upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000

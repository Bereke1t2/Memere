APP_ENV=development
APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=memere
DB_SSL_MODE=disable

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=supersecretkeyshouldbechanged
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# Background expiry sweeper (auto-grades abandoned quiz/exam attempts).
SWEEPER_ENABLED=true
SWEEPER_INTERVAL=60s

# Object storage (Phase 3 video pipeline). For local dev use MinIO:
#   STORAGE_PROVIDER=minio, S3_ENDPOINT=http://localhost:9000,
#   S3_USE_PATH_STYLE=true, keys=minioadmin. For AWS leave S3_ENDPOINT empty.
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://localhost:9000
S3_USE_PATH_STYLE=true
AWS_S3_BUCKET=memere-media
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
UPLOAD_URL_TTL=15m
STREAM_URL_TTL=2h
DOWNLOAD_URL_TTL=2h
# CloudFront signed-URL delivery (production; Skill 4). Leave empty in dev.
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_PEM=

CHAPA_SECRET_KEY=
STRIPE_SECRET_KEY=
FCM_SERVER_KEY=
SENDGRID_API_KEY=

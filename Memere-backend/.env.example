APP_ENV=development
# Local dev / Docker Compose bind port. In production on Cloud Run (or any PaaS)
# the platform injects a PORT env var and routes ONLY to it; the server prefers
# PORT over APP_PORT automatically, so you do not set PORT yourself there.
APP_PORT=8080
# Externally reachable base URL of this API (no trailing slash). Only used to
# build absolute media-proxy and thumbnail URLs when STORAGE_PROVIDER=gdrive.
# In production set this to your real HTTPS domain, e.g. https://api.memere.et
APP_PUBLIC_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# PostgreSQL. In production use an external managed database (Neon / Render Postgres).
# Option A (Recommended for Neon): provide the full connection string:
#   DATABASE_URL=postgresql://neondb_owner:<password>@<host>-pooler.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Option B: discrete vars:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=memere
DB_SSL_MODE=disable

# Connection pooling. On Cloud Run every instance keeps its own pool, so the
# ceiling is DB_MAX_CONNS × max-instances against the database's global limit
# (Neon free tier ~100). Keep DB_MAX_CONNS modest and DB_MIN_CONNS at 0 so idle,
# scaled-in instances release their connections. DB_MAX_CONN_LIFETIME recycles
# long-lived connections.
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_IDLE_TIME=5m
DB_MAX_CONN_LIFETIME=30m
# Set true ONLY when connecting through a transaction-mode pooler (Neon's
# "-pooler" endpoint / PgBouncer). It switches pgx to the simple query protocol,
# which that mode requires. Leave false for a direct endpoint.
DB_POOLED=false

# ---------------------------------------------------------------------------
# Redis. Local dev uses the Docker Compose Redis (no TLS, no auth). In
# production use a managed Redis such as Upstash. Two ways to configure it:
#   A) REDIS_URL — the full connection string Upstash gives you. A rediss://
#      scheme enables TLS automatically; Host/Port/Password/REDIS_TLS are then
#      ignored. This is the simplest for Upstash:
#        REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
#   B) discrete vars — set REDIS_HOST/REDIS_PORT/REDIS_PASSWORD and REDIS_TLS=true
#      (Upstash requires TLS). Use this if you prefer separate secrets.
# SECURITY: the Redis password is a secret — inject it via a secret manager in
# production, never commit it.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# JWT signing secret. MUST be at least 32 characters when APP_ENV=production
# (the server refuses to boot otherwise). Generate one with e.g.
#   openssl rand -base64 48
# and inject it as a secret — never commit a real secret.
JWT_SECRET=supersecretkeyshouldbechanged
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

# ---------------------------------------------------------------------------
# HTTP / security. In production CORS_ALLOWED_ORIGINS MUST be an explicit,
# comma-separated allowlist — the server refuses to boot with "*" when
# APP_ENV=production. TRUSTED_PROXIES lists the proxy CIDRs whose
# X-Forwarded-For header is trusted for client-IP resolution (rate limiting,
# logs); leave empty unless you know the fronting range. See README "Client IP
# behind Cloud Run".
CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_RPM=120
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW=15m
TRUSTED_PROXIES=

# ---------------------------------------------------------------------------
# Background jobs. The five in-process workers run on a ticker and need steady
# CPU. On a scale-to-zero Cloud Run instance (CPU throttled between requests)
# disable the always-on loops and drive the periodic sweeps with Cloud Scheduler
# hitting the authenticated /internal/jobs/* endpoints instead (see README).
#
# Local dev leaves all of these enabled so behavior is unchanged.
SWEEPER_ENABLED=true
SWEEPER_INTERVAL=60s
SUBSCRIPTION_SWEEP_ENABLED=true
SUBSCRIPTION_SWEEP_INTERVAL=1h
ENGAGEMENT_SWEEP_ENABLED=true
ENGAGEMENT_SWEEP_INTERVAL=24h
# Always-on consumer loops (need a steady-CPU worker instance, not scale-to-zero).
NOTIFICATION_WORKER_ENABLED=true
# The transcode worker also needs FFmpeg on PATH; the scale-to-zero API image
# ships without it, so run transcoding from the dedicated worker image.
TRANSCODE_WORKER_ENABLED=true
# Shared secret guarding /internal/jobs/*. When empty (local dev) those routes
# are NOT registered. In production set a strong random value and configure the
# same value as a header on the Cloud Scheduler jobs. Inject it as a secret.
#   openssl rand -hex 32
INTERNAL_JOB_TOKEN=

# ---------------------------------------------------------------------------
# Observability. METRICS_PORT runs a separate /metrics server on its own port;
# Cloud Run only routes to $PORT, so set METRICS_PORT= (empty) there to disable
# the unreachable listener. LOG_LEVEL is debug|info|warn|error. OTEL_ENDPOINT is
# an OTLP/HTTP collector URL ("stdout" for dev, empty for no-op).
METRICS_PORT=9090
LOG_LEVEL=info
OTEL_ENDPOINT=

# ---------------------------------------------------------------------------
# Object storage (Phase 3 video pipeline). Default provider: Backblaze B2.
# B2 exposes an S3-compatible API, so the backend reuses its S3 client — you
# only supply B2's endpoint + application-key credentials. Find them in the B2
# console: Buckets show an "Endpoint" like s3.us-west-004.backblazeb2.com (the
# region is the middle part, us-west-004). Create an Application Key scoped to
# the bucket; the Key ID is the access key and the Application Key is the secret.
#
# SECURITY: the values below are PLACEHOLDERS. Put real B2 keys only in your
# untracked .env (or a secret manager). Never commit them; the backend never
# returns or logs them. See docs/backblaze-b2-setup.md for the full walkthrough.
STORAGE_PROVIDER=b2
B2_APPLICATION_KEY_ID=YOUR_B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY=YOUR_B2_APPLICATION_KEY
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=YOUR_B2_BUCKET_NAME

UPLOAD_URL_TTL=15m
STREAM_URL_TTL=2h
DOWNLOAD_URL_TTL=2h
# CloudFront signed-URL delivery (AWS only; leave empty for B2/MinIO — the store
# then mints its own pre-signed URLs).
CDN_DOMAIN=
CDN_KEY_PAIR_ID=
CDN_PRIVATE_KEY_PEM=

# --- Alternative: AWS S3 / MinIO ------------------------------------------
# Set STORAGE_PROVIDER=s3 (AWS) or minio (local dev) and use these keys instead
# of the B2 block above. For MinIO: S3_ENDPOINT=http://localhost:9000,
# S3_USE_PATH_STYLE=true, keys=minioadmin. For AWS leave S3_ENDPOINT empty.
# S3_ENDPOINT=http://localhost:9000
# S3_USE_PATH_STYLE=true
# AWS_S3_BUCKET=memere-media
# AWS_REGION=af-south-1
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin

# ---------------------------------------------------------------------------
# Google Drive object-storage backend (optional; set STORAGE_PROVIDER=gdrive).
# A SINGLE admin-owned Google account owns ALL files (PDF, image, video).
# Students and teachers NEVER authenticate with Google; only this backend talks
# to Drive. To enable:
#   1. Set STORAGE_PROVIDER=gdrive above (comment out the MinIO/S3 keys).
#   2. Fill GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET from your OAuth 2.0 client.
#   3. Set GOOGLE_DRIVE_ROOT_FOLDER_ID to the Drive folder that will hold files.
#   4. Start the API, sign in as an admin, and open the one-time connect flow
#      (see docs/google-drive-setup.md). Granting offline access stores the
#      refresh token ENCRYPTED in the database — you never paste it here.
# GOOGLE_REFRESH_TOKEN is an alternative for injecting the token from a secret
# manager instead of the connect page; the DB value takes precedence.
#
# SECURITY: these are PLACEHOLDERS. Put real values only in your untracked .env
# (or a secret manager). Never commit them; the backend never returns or logs them.
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/admin/google/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID
# GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# Upload + transcode pipeline (Phase 3 §8.1).
MAX_UPLOAD_BYTES=2147483648
TRANSCODE_QUEUE_BUFFER=64
TRANSCODE_MAX_ATTEMPTS=3
# 0 = worker picks min(2, NumCPU); empty WORKDIR = os.TempDir()/memere-transcode
TRANSCODE_CONCURRENCY=0
TRANSCODE_WORKDIR=

# ---------------------------------------------------------------------------
# Payment providers + notifications. Leave empty to disable a provider. In
# production each enabled provider's webhook secret is REQUIRED (the server
# refuses to boot without it). Inject all of these as secrets — never commit.
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FCM_SERVER_KEY=
SENDGRID_API_KEY=

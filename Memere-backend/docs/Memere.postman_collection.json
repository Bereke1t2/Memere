{
  "info": {
    "name": "Memere Backend (local)",
    "description": "Auth + Course endpoints for the Memere Go backend. Tokens are captured automatically into collection variables by the test scripts on Register/Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "course_id", "value": "" },
    { "key": "section_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (teacher)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const data = b.data || b;",
                  "if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "if (data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"Password123!\",\n  \"first_name\": \"Tina\",\n  \"last_name\": \"Teacher\",\n  \"role\": \"teacher\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/register", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const data = b.data || b;",
                  "if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "if (data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"teacher@example.com\",\n  \"password\": \"Password123!\",\n  \"device_info\": \"postman\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/auth/login", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/auth/me", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "me"] }
          }
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const data = b.data || b;",
                  "if (data.access_token) pm.collectionVariables.set('access_token', data.access_token);",
                  "if (data.refresh_token) pm.collectionVariables.set('refresh_token', data.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/auth/logout", "host": ["{{base_url}}"], "path": ["api", "v1", "auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Courses",
      "item": [
        {
          "name": "Create course",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const data = b.data || b;",
                  "if (data.id) pm.collectionVariables.set('course_id', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Grade 12 Mathematics\",\n  \"description\": \"Full prep for the university entrance exam.\",\n  \"subject\": \"Mathematics\",\n  \"grade\": 12,\n  \"price\": 0,\n  \"currency\": \"ETB\",\n  \"is_free\": true,\n  \"language\": \"en\",\n  \"level\": \"beginner\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/v1/courses", "host": ["{{base_url}}"], "path": ["api", "v1", "courses"] }
          }
        },
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/courses?limit=20",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "courses"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "Get course",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}"] }
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Grade 12 Mathematics (Updated)\"\n}" },
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}"] }
          }
        },
        {
          "name": "Add section",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const b = pm.response.json();",
                  "const data = b.data || b;",
                  "if (data.id) pm.collectionVariables.set('section_id', data.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Unit 1: Algebra\",\n  \"is_published\": true\n}" },
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}/sections", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}", "sections"] }
          }
        },
        {
          "name": "List sections",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}/sections", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}", "sections"] }
          }
        },
        {
          "name": "Add lesson",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Linear Equations\",\n  \"type\": \"video\",\n  \"is_free_preview\": true,\n  \"duration_seconds\": 600,\n  \"is_published\": true\n}" },
            "url": { "raw": "{{base_url}}/api/v1/sections/{{section_id}}/lessons", "host": ["{{base_url}}"], "path": ["api", "v1", "sections", "{{section_id}}", "lessons"] }
          }
        },
        {
          "name": "List lessons",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/v1/sections/{{section_id}}/lessons", "host": ["{{base_url}}"], "path": ["api", "v1", "sections", "{{section_id}}", "lessons"] }
          }
        },
        {
          "name": "Publish course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}/publish", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}", "publish"] }
          }
        },
        {
          "name": "Delete course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{access_token}}" }],
            "url": { "raw": "{{base_url}}/api/v1/courses/{{course_id}}", "host": ["{{base_url}}"], "path": ["api", "v1", "courses", "{{course_id}}"] }
          }
        }
      ]
    }
  ]
}
